<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="es.davante.edadcanina.EdadCaninaModelo" />
        <import type="es.davante.edadcanina.Validacion" />
        <variable
            name="modelo"
            type="es.davante.edadcanina.EdadCaninaModelo" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".MainActivity"
        tools:ignore="ExtraText">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/txt_titulo"
            android:textSize="32sp" />

        <ImageView
            android:layout_width="192dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:adjustViewBounds="true"
            android:src="@drawable/imgdog" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/input_age"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/age_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:gravity="center"
            android:hint="@string/hint_edad"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2"
            android:text="@={modelo.entradaEdad}"
            android:textSize="48sp"
            app:edadMaxima="@{EdadCaninaModelo.EDAD_MAXIMA}"
            app:edadMinima="@{EdadCaninaModelo.EDAD_MINIMA}"
            app:errorValidacion="@{modelo.validacion}" />

        <TextView
            android:id="@+id/result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@{modelo.validacion == Validacion.OK &amp;&amp; modelo.edadCanina > 0 ? @string/tu_edad_format(modelo.edadCanina) : ``}"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_calc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/btn_calc"
            android:textSize="22sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>